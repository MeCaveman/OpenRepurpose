# Deployment-neutral runtime configuration. Override paths only with absolute host-native paths.
# APP_CONFIG_DIR=
# APP_DATA_DIR=
# APP_TEMP_DIR=
# WHISPER_MODEL_DIR=
# DATABASE_URL=
# SESSION_KEY_PATH=
# SECRET_KEY_PATH=
# SECRET_VAULT_PATH=
BIND_HOST=127.0.0.1
PORT=3000
APP_URL=http://127.0.0.1:3000

# Development-only browser and proxy endpoints. The production server serves the built UI itself.
# DEV_SERVER_URL=http://127.0.0.1:5173
# API_SERVER_URL=http://127.0.0.1:3000

# Persistent local job-runner tuning. Defaults are shown.
JOB_CONCURRENCY=2
JOB_PLATFORM_CONCURRENCY=2
JOB_ACCOUNT_CONCURRENCY=1
JOB_AUTH_FAILURE_THRESHOLD=3
JOB_LEASE_MS=30000
JOB_POLL_INTERVAL_MS=250
JOB_RETRY_BASE_MS=1000
JOB_RETRY_MAX_MS=60000

# Optional outbound event webhooks. This JSON array is the explicit endpoint allowlist. Supported
# events: job.succeeded, job.failed, workflow.execution.started, workflow.execution.completed.
# Each secret must contain at least 16 characters and is copied into the encrypted secret vault.
# WEBHOOK_DESTINATIONS_JSON=[{"id":"automation","name":"Local automation","url":"http://127.0.0.1:8787/events","events":["job.succeeded","job.failed"],"secret":"replace-with-a-long-random-secret"}]
WEBHOOK_CONNECT_TIMEOUT_MS=2000
WEBHOOK_TIMEOUT_MS=5000
WEBHOOK_MAX_RESPONSE_BYTES=65536
WEBHOOK_MAX_ATTEMPTS=4
WEBHOOK_RETRY_BASE_MS=1000
WEBHOOK_RETRY_MAX_MS=60000

# FFmpeg transform safety limits. A stalled/expired process is terminated, then force-killed after
# the grace period if needed. Values are milliseconds.
TRANSFORM_TIMEOUT_MS=21600000
TRANSFORM_STALL_TIMEOUT_MS=300000
TRANSFORM_KILL_GRACE_MS=5000

# Watched-folder scans are portable across Windows and Linux. A file must keep its size and mtime
# unchanged for WATCH_SETTLE_MS before it is imported.
WATCH_POLL_INTERVAL_MS=2000
WATCH_SETTLE_MS=10000

# Optional OBS WebSocket v5 scan hint. Folder scans remain authoritative, so OBS does not need to
# be running. A ws endpoint is restricted to loopback; use wss for any remote endpoint. The
# password is copied to the local encrypted secret vault at startup and never sent to the browser.
# OBS_WEBSOCKET_URL=ws://127.0.0.1:4455
# OBS_WEBSOCKET_PASSWORD=
# OBS_WEBSOCKET_RECONNECT_MS=5000
