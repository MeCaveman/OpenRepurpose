# Deployment-neutral runtime configuration. Override paths only with absolute host-native paths.
# APP_CONFIG_DIR=
# APP_DATA_DIR=
# APP_TEMP_DIR=
# WHISPER_MODEL_DIR=
# DATABASE_URL=
# SESSION_KEY_PATH=
# SECRET_KEY_PATH=
# SECRET_VAULT_PATH=
BIND_HOST=127.0.0.1
PORT=3000
APP_URL=http://127.0.0.1:3000

# Development-only browser and proxy endpoints. The production server serves the built UI itself.
# DEV_SERVER_URL=http://127.0.0.1:5173
# API_SERVER_URL=http://127.0.0.1:3000

# Persistent local job-runner tuning. Defaults are shown.
JOB_CONCURRENCY=2
JOB_PLATFORM_CONCURRENCY=2
JOB_ACCOUNT_CONCURRENCY=1
JOB_AUTH_FAILURE_THRESHOLD=3
JOB_LEASE_MS=30000
JOB_POLL_INTERVAL_MS=250
JOB_RETRY_BASE_MS=1000
JOB_RETRY_MAX_MS=60000

# FFmpeg transform safety limits. A stalled/expired process is terminated, then force-killed after
# the grace period if needed. Values are milliseconds.
TRANSFORM_TIMEOUT_MS=21600000
TRANSFORM_STALL_TIMEOUT_MS=300000
TRANSFORM_KILL_GRACE_MS=5000

# Watched-folder scans are portable across Windows and Linux. A file must keep its size and mtime
# unchanged for WATCH_SETTLE_MS before it is imported.
WATCH_POLL_INTERVAL_MS=2000
WATCH_SETTLE_MS=10000
