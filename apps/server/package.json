{
  "name": "@openrepurpose/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "cross-env DEV_SERVER_URL=http://127.0.0.1:5173 tsx watch src/index.ts",
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@fastify/secure-session": "8.3.0",
    "@fastify/static": "10.1.3",
    "@openrepurpose/shared": "workspace:*",
