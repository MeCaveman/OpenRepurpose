    "@openrepurpose/db": "workspace:*",
    "@openrepurpose/media": "workspace:*",
    "@openrepurpose/platform-sdk": "workspace:*",
    "fastify": "5.12.5"
  },
  "devDependencies": {
    "@types/node": "24.13.5",
    "cross-env": "10.1.0",
    "tsx": "4.23.13"
